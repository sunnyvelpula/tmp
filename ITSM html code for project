<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ITSM Ticketing Tool · Full Operation Mode</title>
  <!-- Font Awesome 5 for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }

    body {
      background: #f0f2f5;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
    }

    /* main app container */
    .itsm-app {
      width: 1400px;
      max-width: 100%;
      height: 90vh;
      background: #ffffff;
      border-radius: 24px;
      box-shadow: 0 20px 35px rgba(0, 20, 40, 0.15), 0 8px 16px rgba(0, 0, 0, 0.05);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid #e9ecf0;
    }

    /* header / top bar */
    .app-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 28px;
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      flex-shrink: 0;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-icon {
      background: #1e3a8a;
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 20px;
    }

    .logo-text {
      font-weight: 700;
      font-size: 20px;
      color: #0b1e3a;
      letter-spacing: -0.3px;
    }

    .logo-text span {
      color: #2563eb;
      font-weight: 600;
    }

    .header-actions {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .mode-badge {
      background: #e6f7ed;
      color: #0b6e4f;
      font-weight: 600;
      font-size: 13px;
      padding: 6px 14px;
      border-radius: 30px;
      display: flex;
      align-items: center;
      gap: 6px;
      border: 1px solid #b7e4d0;
    }

    .mode-badge i {
      font-size: 12px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #f8fafc;
      padding: 6px 12px 6px 8px;
      border-radius: 40px;
      border: 1px solid #e2e8f0;
    }

    .avatar {
      background: #2563eb;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 14px;
    }

    .user-name {
      font-size: 14px;
      font-weight: 600;
      color: #1e293b;
    }

    /* main body: sidebar + content */
    .app-body {
      display: flex;
      flex: 1;
      overflow: hidden;
      background: #f9fbfd;
    }

    /* sidebar */
    .sidebar {
      width: 260px;
      background: #ffffff;
      border-right: 1px solid #e9ecf0;
      display: flex;
      flex-direction: column;
      padding: 24px 16px;
      overflow-y: auto;
      flex-shrink: 0;
    }

    .nav-section {
      margin-bottom: 32px;
    }

    .nav-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 700;
      color: #64748b;
      margin-bottom: 12px;
      padding-left: 12px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border-radius: 12px;
      color: #1e293b;
      font-weight: 500;
      font-size: 15px;
      cursor: default;
      transition: background 0.1s;
      margin-bottom: 4px;
      background: #ffffff;
    }

    .nav-item i {
      width: 20px;
      color: #5b6f8c;
      font-size: 16px;
    }

    .nav-item.active {
      background: #eff6ff;
      color: #1e4fd9;
      font-weight: 600;
    }

    .nav-item.active i {
      color: #2563eb;
    }

    .nav-item:not(.active):hover {
      background: #f1f5f9;
    }

    .nav-badge {
      margin-left: auto;
      background: #e2e8f0;
      color: #1e293b;
      font-size: 12px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
    }

    /* main content */
    .main-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      padding: 24px 28px 28px 28px;
      background: #f9fbfd;
    }

    /* stats row */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: #ffffff;
      padding: 20px 20px;
      border-radius: 20px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.02);
      border: 1px solid #eef2f6;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .stat-info h4 {
      font-size: 14px;
      font-weight: 600;
      color: #64748b;
      margin-bottom: 6px;
    }

    .stat-number {
      font-size: 28px;
      font-weight: 700;
      color: #0b1e3a;
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      background: #eff6ff;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #2563eb;
      font-size: 22px;
    }

    /* toolbar */
    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 16px;
    }

    .filter-tabs {
      display: flex;
      gap: 8px;
      background: #ffffff;
      padding: 6px;
      border-radius: 40px;
      border: 1px solid #e2e8f0;
    }

    .filter-tab {
      padding: 8px 18px;
      border-radius: 30px;
      font-size: 14px;
      font-weight: 600;
      color: #475569;
      background: transparent;
      border: none;
      cursor: default;
      transition: all 0.1s;
    }

    .filter-tab.active {
      background: #ffffff;
      color: #2563eb;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border: 1px solid #e2e8f0;
    }

    .search-box {
      display: flex;
      align-items: center;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 40px;
      padding: 8px 18px;
      gap: 10px;
      width: 260px;
    }

    .search-box i {
      color: #94a3b8;
      font-size: 16px;
    }

    .search-box input {
      border: none;
      background: transparent;
      outline: none;
      font-size: 14px;
      width: 100%;
      color: #1e293b;
    }

    .search-box input::placeholder {
      color: #94a3b8;
    }

    .btn-new {
      background: #2563eb;
      color: white;
      border: none;
      padding: 10px 24px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: default;
      box-shadow: 0 8px 16px -4px rgba(37, 99, 235, 0.3);
      transition: background 0.1s;
    }

    .btn-new i {
      font-size: 14px;
    }

    /* ticket table */
    .ticket-table-wrapper {
      background: #ffffff;
      border-radius: 20px;
      border: 1px solid #eef2f6;
      overflow: auto;
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.02);
      flex: 1;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
    }

    th {
      text-align: left;
      padding: 16px 18px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      color: #64748b;
      background: #f8fafc;
      border-bottom: 1px solid #e9ecf0;
    }

    td {
      padding: 16px 18px;
      font-size: 14px;
      border-bottom: 1px solid #f1f5f9;
      color: #1e293b;
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    .ticket-id {
      font-weight: 700;
      color: #2563eb;
      font-size: 14px;
      letter-spacing: -0.2px;
    }

    .ticket-subject {
      font-weight: 600;
      color: #0b1e3a;
      max-width: 260px;
    }

    .requester {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .requester-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #dbeafe;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      color: #1e4fd9;
    }

    .priority-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 40px;
      font-size: 12px;
      font-weight: 700;
      text-align: center;
      min-width: 70px;
    }

    .priority-critical {
      background: #fee2e2;
      color: #b91c1c;
    }

    .priority-high {
      background: #ffedd5;
      color: #b45309;
    }

    .priority-medium {
      background: #fef9c3;
      color: #854d0e;
    }

    .priority-low {
      background: #dcfce7;
      color: #166534;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border-radius: 40px;
      font-size: 12px;
      font-weight: 700;
      background: #f1f5f9;
      color: #334155;
    }

    .status-open {
      background: #e0f2fe;
      color: #0369a1;
    }

    .status-progress {
      background: #fff3cd;
      color: #856404;
    }

    .status-resolved {
      background: #d1fae5;
      color: #065f46;
    }

    .status-closed {
      background: #e2e8f0;
      color: #334155;
    }

    .assignee {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .assignee i {
      color: #94a3b8;
      font-size: 14px;
    }

    .action-icons {
      display: flex;
      gap: 12px;
      color: #94a3b8;
    }

    .action-icons i {
      cursor: default;
      transition: color 0.1s;
      font-size: 16px;
    }

    .action-icons i:hover {
      color: #2563eb;
    }

    /* pagination footer */
    .table-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px;
      background: #ffffff;
      border-top: 1px solid #eef2f6;
      font-size: 14px;
      color: #475569;
    }

    .pagination {
      display: flex;
      gap: 6px;
    }

    .page-btn {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid #e2e8f0;
      color: #1e293b;
      font-weight: 600;
      font-size: 13px;
      cursor: default;
    }

    .page-btn.active {
      background: #2563eb;
      border-color: #2563eb;
      color: white;
    }

    .page-btn i {
      font-size: 12px;
    }

    /* minor scrollbar styling */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }

    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }

    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 10px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* full operation mode indicator */
    .full-mode-badge {
      background: #2563eb10;
      border: 1px dashed #2563eb40;
      border-radius: 14px;
      padding: 6px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #2563eb;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .full-mode-badge i {
      font-size: 12px;
    }

  </style>
</head>
<body>
  <div class="itsm-app">
    <!-- HEADER -->
    <header class="app-header">
      <div class="logo-area">
        <div class="logo-icon">
          <i class="fas fa-headset"></i>
        </div>
        <div class="logo-text">ITSM<span>Flow</span></div>
      </div>
      <div class="header-actions">
        <div class="full-mode-badge">
          <i class="fas fa-circle-play"></i> Full Operation Mode
        </div>
        <div class="mode-badge">
          <i class="fas fa-check-circle"></i> Live · all systems operational
        </div>
        <div class="user-profile">
          <div class="avatar">JD</div>
          <span class="user-name">Jessie Du</span>
        </div>
      </div>
    </header>

    <!-- BODY (SIDEBAR + MAIN) -->
    <div class="app-body">
      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="nav-section">
          <div class="nav-label">Workspace</div>
          <div class="nav-item active">
            <i class="fas fa-ticket-alt"></i> All Tickets
            <span class="nav-badge">47</span>
          </div>
          <div class="nav-item">
            <i class="fas fa-inbox"></i> My Queue
            <span class="nav-badge">12</span>
          </div>
          <div class="nav-item">
            <i class="fas fa-flag"></i> Priority
            <span class="nav-badge">5</span>
          </div>
          <div class="nav-item">
            <i class="fas fa-clock"></i> Unresolved
            <span class="nav-badge">19</span>
          </div>
        </div>

        <div class="nav-section">
          <div class="nav-label">Service Desk</div>
          <div class="nav-item">
            <i class="fas fa-chart-pie"></i> Dashboard
          </div>
          <div class="nav-item">
            <i class="fas fa-users"></i> Teams
          </div>
          <div class="nav-item">
            <i class="fas fa-cog"></i> Settings
          </div>
        </div>

        <div class="nav-section">
          <div class="nav-label">Categories</div>
          <div class="nav-item">
            <i class="fas fa-network-wired"></i> Network
          </div>
          <div class="nav-item">
            <i class="fas fa-laptop"></i> Hardware
          </div>
          <div class="nav-item">
            <i class="fas fa-shield-alt"></i> Security
          </div>
          <div class="nav-item">
            <i class="fas fa-envelope"></i> Software
          </div>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="main-content">
        <!-- stats row -->
        <div class="stats-row">
          <div class="stat-card">
            <div class="stat-info">
              <h4>Open tickets</h4>
              <div class="stat-number">24</div>
            </div>
            <div class="stat-icon">
              <i class="fas fa-folder-open"></i>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-info">
              <h4>In progress</h4>
              <div class="stat-number">12</div>
            </div>
            <div class="stat-icon">
              <i class="fas fa-spinner"></i>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-info">
              <h4>Resolved today</h4>
              <div class="stat-number">18</div>
            </div>
            <div class="stat-icon">
              <i class="fas fa-check-circle"></i>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-info">
              <h4>Avg. response</h4>
              <div class="stat-number">2.4h</div>
            </div>
            <div class="stat-icon">
              <i class="fas fa-stopwatch"></i>
            </div>
          </div>
        </div>

        <!-- toolbar -->
        <div class="toolbar">
          <div class="filter-tabs">
            <button class="filter-tab active">All tickets</button>
            <button class="filter-tab">My tickets</button>
            <button class="filter-tab">Unassigned</button>
            <button class="filter-tab">Overdue</button>
          </div>
          <div style="display: flex; gap: 12px; align-items: center;">
            <div class="search-box">
              <i class="fas fa-search"></i>
              <input type="text" placeholder="Search tickets, IDs, requesters...">
            </div>
            <button class="btn-new">
              <i class="fas fa-plus"></i> New ticket
            </button>
          </div>
        </div>

        <!-- ticket table -->
        <div class="ticket-table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Ticket</th>
                <th>Subject</th>
                <th>Requester</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Assignee</th>
                <th style="text-align: center;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <!-- row 1 -->
              <tr>
                <td><span class="ticket-id">INC-2047</span></td>
                <td class="ticket-subject">VPN access not working after password reset</td>
                <td>
                  <div class="requester">
                    <div class="requester-avatar">MC</div>
                    <span>Maria Chen</span>
                  </div>
                </td>
                <td><span class="priority-badge priority-critical">Critical</span></td>
                <td><span class="status-badge status-open"><i class="fas fa-circle" style="font-size: 8px; color: #0369a1;"></i> Open</span></td>
                <td>
                  <div class="assignee">
                    <i class="fas fa-user-circle"></i> Alex Rivera
                  </div>
                </td>
                <td>
                  <div class="action-icons">
                    <i class="fas fa-eye" title="View"></i>
                    <i class="fas fa-edit" title="Edit"></i>
                    <i class="fas fa-comment" title="Comment"></i>
                  </div>
                </td>
              </tr>
              <!-- row 2 -->
              <tr>
                <td><span class="ticket-id">INC-2046</span></td>
                <td class="ticket-subject">Laptop overheating and shutting down</td>
                <td>
                  <div class="requester">
                    <div class="requester-avatar">JT</div>
                    <span>James Thompson</span>
                  </div>
                </td>
                <td><span class="priority-badge priority-high">High</span></td>
                <td><span class="status-badge status-progress"><i class="fas fa-circle" style="font-size: 8px; color: #856404;"></i> In progress</span></td>
                <td>
                  <div class="assignee">
                    <i class="fas fa-user-circle"></i> Priya Nair
                  </div>
                </td>
                <td>
                  <div class="action-icons">
                    <i class="fas fa-eye"></i>
                    <i class="fas fa-edit"></i>
                    <i class="fas fa-comment"></i>
                  </div>
                </td>
              </tr>
              <!-- row 3 -->
              <tr>
                <td><span class="ticket-id">SR-1182</span></td>
                <td class="ticket-subject">Software license renewal for Adobe CC</td>
                <td>
                  <div class="requester">
                    <div class="requester-avatar">LW</div>
                    <span>Lena Wong</span>
                  </div>
                </td>
                <td><span class="priority-badge priority-medium">Medium</span></td>
                <td><span class="status-badge status-open"><i class="fas fa-circle" style="font-size: 8px; color: #0369a1;"></i> Open</span></td>
                <td>
                  <div class="assignee">
                    <i class="fas fa-user-circle"></i> Unassigned
                  </div>
                </td>
                <td>
                  <div class="action-icons">
                    <i class="fas fa-eye"></i>
                    <i class="fas fa-edit"></i>
                    <i class="fas fa-comment"></i>
                  </div>
                </td>
              </tr>
              <!-- row 4 -->
              <tr>
                <td><span class="ticket-id">INC-2043</span></td>
                <td class="ticket-subject">Email sync issue on mobile devices</td>
                <td>
                  <div class="requester">
                    <div class="requester-avatar">DR</div>
                    <span>David Kim</span>
                  </div>
                </td>
                <td><span class="priority-badge priority-high">High</span></td>
                <td><span class="status-badge status-progress"><i class="fas fa-circle" style="font-size: 8px; color: #856404;"></i> In progress</span></td>
                <td>
                  <div class="assignee">
                    <i class="fas fa-user-circle"></i> Alex Rivera
                  </div>
                </td>
                <td>
                  <div class="action-icons">
                    <i class="fas fa-eye"></i>
                    <i class="fas fa-edit"></i>
                    <i class="fas fa-comment"></i>
                  </div>
                </td>
              </tr>
              <!-- row 5 -->
              <tr>
                <td><span class="ticket-id">SR-1179</span></td>
                <td class="ticket-subject">New employee onboarding – access request</td>
                <td>
                  <div class="requester">
                    <div class="requester-avatar">SP</div>
                    <span>Sophia Patel</span>
                  </div>
                </td>
                <td><span class="priority-badge priority-low">Low</span></td>
                <td><span class="status-badge status-resolved"><i class="fas fa-check-circle" style="font-size: 10px; color: #065f46;"></i> Resolved</span></td>
                <td>
                  <div class="assignee">
                    <i class="fas fa-user-circle"></i> Priya Nair
                  </div>
                </td>
                <td>
                  <div class="action-icons">
                    <i class="fas fa-eye"></i>
                    <i class="fas fa-edit"></i>
                    <i class="fas fa-comment"></i>
                  </div>
                </td>
              </tr>
              <!-- row 6 -->
              <tr>
                <td><span class="ticket-id">INC-2038</span></td>
                <td class="ticket-subject">Shared drive access denied for Finance</td>
                <td>
                  <div class="requester">
                    <div class="requester-avatar">RB</div>
                    <span>Robert Blake</span>
                  </div>
                </td>
                <td><span class="priority-badge priority-critical">Critical</span></td>
                <td><span class="status-badge status-open"><i class="fas fa-circle" style="font-size: 8px; color: #0369a1;"></i> Open</span></td>
                <td>
                  <div class="assignee">
                    <i class="fas fa-user-circle"></i> Chris Lee
                  </div>
                </td>
                <td>
                  <div class="action-icons">
